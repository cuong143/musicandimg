local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

local url = "https://raw.githubusercontent.com/cuong143/musicandimg/refs/heads/main/h2h4.jpg"

-- Xóa GUI cũ
for _, v in ipairs(CoreGui:GetChildren()) do
    if v.Name == "h2h4" then
        v:Destroy()
    end
end

-- Tạo tên file mới mỗi lần chạy
local file = "h2h4_" .. HttpService:GenerateGUID(false) .. ".jpg"

-- Tải ảnh mới
local success, data = pcall(function()
    return game:HttpGet(url .. "?t=" .. os.time())
end)

if not success then
    warn("Không tải được ảnh: " .. tostring(data))
    return
end

writefile(file, data)

-- Tạo GUI
local gui = Instance.new("ScreenGui")
gui.Name = "h2h4"
gui.Parent = CoreGui

local image = Instance.new("ImageLabel")

-- Check thiết bị PC hay PE (mobile/tablet)
local isPE = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local width
if isPE then
    width = 250   -- mobile/tablet
else
    width = 1200   -- PC (bạn chỉnh số này tùy ý)
end

local height = width * (926 / 2160) -- giữ đúng tỉ lệ ảnh gốc

image.Size = UDim2.fromOffset(width, height)
image.Position = UDim2.fromScale(0.5, 0.5)
image.AnchorPoint = Vector2.new(0.5, 0.5)
image.BackgroundTransparency = 1
image.Image = getcustomasset(file)
image.Parent = gui

task.wait(3)
gui:Destroy()

-- Xóa file sau khi dùng
if isfile(file) then
    delfile(file)
end
