local url = "https://raw.githubusercontent.com/cuong143/musicandimg/refs/heads/main/supernovalove.mp3"
local file = "supernovalove.mp3"

if not isfile(file) then
    writefile(file, game:HttpGet(url))
end

local sound = Instance.new("Sound")
sound.SoundId = getcustomasset(file)
sound.Volume = 6
sound.Looped = true
sound.Parent = game:GetService("SoundService")
sound:Play()

return sound
