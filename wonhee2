local url = "https://raw.githubusercontent.com/cuong143/musicandimg/refs/heads/main/wonheeimg.jpeg"
local file = "wonhee1.jpeg"

-- Xóa GUI cũ
local CoreGui = game:GetService("CoreGui")
local oldGui = CoreGui:FindFirstChild("wonhee1")

if oldGui then
    oldGui:Destroy()
end

-- Xóa file ảnh cũ để tải lại ảnh mới
if isfile(file) then
    delfile(file)
end

-- Tải ảnh mới
writefile(file, game:HttpGet(url))

-- Tạo GUI
local gui = Instance.new("ScreenGui")
gui.Name = "wonhee1"
gui.Parent = CoreGui

local image = Instance.new("ImageLabel")

local width = 250
local height = width * (1200 / 1500)

image.Size = UDim2.fromOffset(width, height)
image.Position = UDim2.fromScale(0.5, 0.5)
image.AnchorPoint = Vector2.new(0.5, 0.5)
image.BackgroundTransparency = 1
image.Image = getcustomasset(file)
image.Parent = gui

task.wait(3)

gui:Destroy()
